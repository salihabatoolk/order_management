<div class="min-h-screen bg-base-200 p-6">

  <div class="mx-auto max-w-3xl">

    <!-- Header -->
    <div class="mb-8">
      <a
        href={~p"/orders"}
        class="text-sm text-primary hover:underline"
      >
        ← Back to Orders
      </a>

      <h1 class="mt-4 text-3xl font-bold">
        Create New Order
      </h1>
    </div>

    <!-- Form Card -->
    <div class="card bg-base-100 shadow-xl">

      <div class="card-body">

        <h2 class="card-title mb-6">
          Order Information
        </h2>

        <.form for={@changeset} action={~p"/orders"}>

          <!-- Customer -->
          <div class="form-control mb-7">

            <label class="label mb-2" for="customer_id">
              <span class="label-text text-base font-bold">
                Customer
              </span>
            </label>

            <select
              id="customer_id"
              name="order[customer_id]"
              class="select select-bordered w-full"
            >
              <option value="">
                Select a customer
              </option>

              <%= for customer <- @customers do %>
                <option value={customer.id}>
                  <%= customer.name %> — <%= customer.email %>
                </option>
              <% end %>
            </select>

          </div>

          <!-- Add Customer -->
          <div class="mb-7">
            <a
              href={~p"/customers/new"}
              class="btn btn-outline btn-secondary btn-sm"
            >
              + Add New Customer
            </a>
          </div>

          <!-- Items -->
          <div class="form-control mb-7">

            <label class="label mb-2" for="items">
              <span class="label-text text-base font-bold">
                Items
              </span>
            </label>

            <input
              type="text"
              id="items"
              name="order[items]"
              placeholder="e.g. Laptop, Mouse, Keyboard"
              class="input input-bordered w-full"
            />

          </div>

          <!-- Status -->
          <div class="form-control mb-8">

            <label class="label mb-2" for="status">
              <span class="label-text text-base font-bold">
                Order Status
              </span>
            </label>

            <select
              id="status"
              name="order[status]"
              class="select select-bordered w-full"
            >
              <option value="pending">Pending</option>
              <option value="completed">Completed</option>
              <option value="cancelled">Cancelled</option>
            </select>

          </div>

          <!-- Buttons -->
          <div class="flex justify-end gap-3">

            <a
              href={~p"/orders"}
              class="btn btn-ghost"
            >
              Cancel
            </a>

            <button
              type="submit"
              class="btn btn-primary"
            >
              Create Order
            </button>

          </div>

        </.form>

      </div>
    </div>

  </div>
</div>

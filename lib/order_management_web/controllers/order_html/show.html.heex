<h1>Order Details</h1>

<p>
  <strong>ID:</strong>
  <%= @order.id %>
</p>

<p>
  <strong>Customer:</strong>
  <%= @order.customer.name %>
</p>

<p>
  <strong>Email:</strong>
  <%= @order.customer.email %>
</p>

<p>
  <strong>Items:</strong>
  <%= Enum.join(@order.items, ", ") %>
</p>

<p>
  <strong>Status:</strong>
  <%= @order.status %>
</p>

<br />

<a href={~p"/orders"}>Back to Orders</a>

<br />
<br />

<a href={~p"/orders/#{@order.id}/edit"}>Edit Order</a>

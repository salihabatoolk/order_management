<div class="min-h-screen bg-base-200 p-6">

  <div class="mx-auto max-w-3xl">

    <!-- Header -->
    <div class="mb-8">

      <div class="mt-4 flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold">
            Order Details
          </h1>
        </div>

        <span class="badge badge-primary badge-lg">
          Order #<%= @order.id %>
        </span>
      </div>

    </div>

    <!-- Order Card -->
    <div class="card bg-base-100 shadow-xl">

      <div class="card-body">

        <!-- Customer Section -->
        <div class="mb-6">

          <h2 class="text-lg font-bold mb-3">
            Customer
          </h2>

          <div class="rounded-xl bg-base-200 p-4">

            <%= if @order.customer do %>

              <p class="font-semibold text-lg">
                <%= @order.customer.name %>
              </p>

              <p class="text-sm text-base-content/60 mt-1">
                Email: <%= @order.customer.email %>
              </p>

              <p class="text-sm text-base-content/60 mt-1">
                Phone: <%= @order.customer.phone %>
              </p>

            <% else %>

              <p class="text-base-content/50">
                No customer assigned
              </p>

            <% end %>

          </div>

        </div>

        <!-- Items -->
        <div class="mb-6">

          <h2 class="text-lg font-bold mb-3">
            Items
          </h2>

          <div class="rounded-xl border border-base-300 p-4">

            <%= for {item, index} <- Enum.with_index(@order.items) do %>

              <span class="badge badge-outline mr-2 mb-2">
                <%= item %><%= if index < length(@order.items) - 1, do: "," %>
              </span>

            <% end %>

          </div>

        </div>

        <!-- Status -->
        <div class="mb-8">

          <h2 class="text-lg font-bold mb-3">
            Status
          </h2>

          <%= case @order.status do %>

            <% :pending -> %>
              <span class="badge badge-warning badge-lg">
                Pending
              </span>

            <% :completed -> %>
              <span class="badge badge-success badge-lg">
                Completed
              </span>

            <% :cancelled -> %>
              <span class="badge badge-error badge-lg">
                Cancelled
              </span>

          <% end %>

        </div>

        <!-- Actions -->
        <div class="flex justify-end gap-3">

          <a
            href={~p"/orders/#{@order.id}/edit"}
            class="btn btn-warning"
          >
            Edit Order
          </a>

          <a
            href={~p"/orders"}
            class="btn btn-ghost"
          >
            Back to Orders
          </a>

        </div>

      </div>

    </div>

  </div>

</div>

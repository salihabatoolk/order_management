<h1>Orders</h1>

<a href={~p"/orders/new"}>New Order</a>

<br />
<br />

<table border="1">
  <thead>
    <tr>
      <th>ID</th>
      <th>Customer</th>
      <th>Email</th>
      <th>Items</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <%= for order <- @orders do %>
      <tr>
        <td><%= order.id %></td>

```
    <td>
      <%= if order.customer do %>
        <%= order.customer.name %>
      <% else %>
        No Customer
      <% end %>
    </td>

    <td>
      <%= if order.customer do %>
        <%= order.customer.email %>
      <% else %>
        -
      <% end %>
    </td>

    <td>
      <%= Enum.join(order.items, ", ") %>
    </td>

    <td>
      <%= order.status %>
    </td>

    <td>
      <a href={~p"/orders/#{order.id}"}>View</a>
      |
      <a href={~p"/orders/#{order.id}/edit"}>Edit</a>
      |
      <.link
        href={~p"/orders/#{order.id}"}
        method="delete"
        data-confirm="Are you sure you want to delete this order?"
      >
        Delete
      </.link>
    </td>
  </tr>
<% end %>
```

  </tbody>
</table>

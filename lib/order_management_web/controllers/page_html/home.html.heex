<div class="min-h-screen bg-base-200 p-6">

  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold">
      Order Management System
    </h1>

    <h2 class="mt-2 text-xl font-semibold">
      Dashboard
    </h2>
  </div>


  <!-- Stats -->

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-5 mb-8">

    <!-- Total Orders -->

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">

        <p class="text-sm text-base-content/60">
          Total Orders
        </p>

        <h2 class="text-3xl font-bold">
          <%= @orders_count %>
        </h2>

      </div>
    </div>


    <!-- Total Customers -->

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">

        <p class="text-sm text-base-content/60">
          Total Customers
        </p>

        <h2 class="text-3xl font-bold">
          <%= @customers_count %>
        </h2>

        <a
          href={~p"/customers"}
          class="text-sm text-primary hover:underline mt-2"
        >
          View Customers →
        </a>

      </div>
    </div>


    <!-- Pending Orders -->

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">

        <div class="flex items-center justify-between">

          <p class="text-sm text-base-content/60">
            Pending Orders
          </p>

          <span class="text-2xl">
            ⏳
          </span>

        </div>

        <h2 class="text-3xl font-bold text-warning">
          <%= @pending_orders %>
        </h2>

        <p class="text-sm text-base-content/50 mt-2">
          Waiting for completion
        </p>

      </div>
    </div>


    <!-- Completed Orders -->

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">

        <div class="flex items-center justify-between">

          <p class="text-sm text-base-content/60">
            Completed Orders
          </p>

          <span class="text-2xl">
            ✓
          </span>

        </div>

        <h2 class="text-3xl font-bold text-success">
          <%= @completed_orders %>
        </h2>

        <p class="text-sm text-base-content/50 mt-2">
          Successfully completed
        </p>

      </div>
    </div>


    <!-- Cancelled Orders -->

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">

        <div class="flex items-center justify-between">

          <p class="text-sm text-base-content/60">
            Cancelled Orders
          </p>

          <span class="text-2xl">
            ✕
          </span>

        </div>

        <h2 class="text-3xl font-bold text-error">
          <%= @cancelled_orders %>
        </h2>

        <p class="text-sm text-base-content/50 mt-2">
          Cancelled orders
        </p>

      </div>
    </div>

  </div>


  <!-- Quick Actions -->

  <div class="card bg-base-100 shadow-xl">

    <div class="card-body">

      <h2 class="card-title mb-4">
        Quick Actions
      </h2>

      <div class="flex flex-wrap gap-4">

        <a
          href={~p"/orders/new"}
          class="btn btn-primary"
        >
          + Create New Order
        </a>

        <a
          href={~p"/customers/new"}
          class="btn btn-outline btn-secondary"
        >
          + Add New Customer
        </a>

        <a
          href={~p"/orders"}
          class="btn btn-outline"
        >
          View All Orders
        </a>

      </div>

    </div>

  </div>

</div>

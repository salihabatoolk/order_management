<div class="min-h-screen bg-base-200 p-6">

  <div class="mb-8">
    <h1 class="text-3xl font-bold">
      Dashboard
    </h1>

    <p class="mt-1 text-base-content/60">
      Overview of your order management system
    </p>
  </div>

  <!-- Stats -->

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4 mb-8">

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <p class="text-sm text-base-content/60">
          Total Orders
        </p>

        <h2 class="text-3xl font-bold">
          <%= @orders_count %>
        </h2>

        <a
          href={~p"/orders"}
          class="text-sm text-primary hover:underline mt-2"
        >
          View Orders →
        </a>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <p class="text-sm text-base-content/60">
          Total Customers
        </p>

        <h2 class="text-3xl font-bold">
          <%= @customers_count %>
        </h2>

        <a
          href={~p"/customers"}
          class="text-sm text-primary hover:underline mt-2"
        >
          View Customers →
        </a>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <p class="text-sm text-base-content/60">
          Pending Orders
        </p>

        <h2 class="text-3xl font-bold text-warning">
          <%= @pending_orders %>
        </h2>

        <p class="text-sm text-base-content/50 mt-2">
          Waiting for completion
        </p>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <p class="text-sm text-base-content/60">
          Completed Orders
        </p>

        <h2 class="text-3xl font-bold text-success">
          <%= @completed_orders %>
        </h2>

        <p class="text-sm text-base-content/50 mt-2">
          Successfully completed
        </p>
      </div>
    </div>

  </div>

  <!-- Order Status -->

  <div class="grid gap-6 lg:grid-cols-2">

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">

        <h2 class="card-title">
          Order Status
        </h2>

        <div class="space-y-4 mt-4">

          <div class="flex items-center justify-between">
            <span>Pending</span>

            <span class="badge badge-warning">
              <%= @pending_orders %>
            </span>
          </div>

          <div class="flex items-center justify-between">
            <span>Completed</span>

            <span class="badge badge-success">
              <%= @completed_orders %>
            </span>
          </div>

          <div class="flex items-center justify-between">
            <span>Cancelled</span>

            <span class="badge badge-error">
              <%= @cancelled_orders %>
            </span>
          </div>

        </div>

      </div>
    </div>

    <!-- Quick Actions -->

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">

        <h2 class="card-title">
          Quick Actions
        </h2>

        <div class="flex flex-col gap-3 mt-4">

          <a
            href={~p"/orders/new"}
            class="btn btn-primary"
          >
            + Create New Order
          </a>

          <a
            href={~p"/customers/new"}
            class="btn btn-outline btn-secondary"
          >
            + Add New Customer
          </a>

          <a
            href={~p"/orders"}
            class="btn btn-outline"
          >
            View All Orders
          </a>

        </div>

      </div>
    </div>

  </div>

</div>

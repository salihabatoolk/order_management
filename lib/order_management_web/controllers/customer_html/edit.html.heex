<div class="min-h-screen bg-base-200 p-6">

  <div class="mx-auto max-w-3xl">

    <!-- Header -->
    <div class="mb-8">

      <a
        href={~p"/customers"}
        class="text-sm text-primary hover:underline"
      >
        ← Back to Customers
      </a>

      <h1 class="mt-4 text-3xl font-bold">
        Edit Customer
      </h1>

    </div>

    <!-- Form Card -->
    <div class="card bg-base-100 shadow-xl">

      <div class="card-body">

        <h2 class="card-title mb-6">
          Customer Information
        </h2>

        <.form
          for={@changeset}
          action={~p"/customers/#{@customer.id}"}
          method="put"
        >

          <!-- Customer Name -->
          <div class="form-control mb-7">

            <label class="label mb-2" for="name">
              <span class="label-text text-base font-bold">
                Customer Name
              </span>
            </label>

            <input
              type="text"
              id="name"
              name="customer[name]"
              value={@customer.name}
              placeholder="Enter customer name"
              class="input input-bordered w-full"
            />

          </div>

          <!-- Email -->
          <div class="form-control mb-7">

            <label class="label mb-2" for="email">
              <span class="label-text text-base font-bold">
                Email
              </span>
            </label>

            <input
              type="email"
              id="email"
              name="customer[email]"
              value={@customer.email}
              placeholder="Enter customer email"
              class="input input-bordered w-full"
            />

          </div>

          <!-- Phone Number -->
          <div class="form-control mb-8">

            <label class="label mb-2" for="phone">
              <span class="label-text text-base font-bold">
                Phone Number
              </span>
            </label>

            <input
              type="tel"
              id="phone"
              name="customer[phone]"
              value={@customer.phone}
              placeholder="Enter phone number"
              class="input input-bordered w-full"
            />

          </div>

          <!-- Buttons -->
          <div class="flex justify-end gap-3">

            <a
              href={~p"/customers"}
              class="btn btn-ghost"
            >
              Cancel
            </a>

            <button
              type="submit"
              class="btn btn-primary"
            >
              Save Changes
            </button>

          </div>

        </.form>

      </div>
    </div>

  </div>

</div>
